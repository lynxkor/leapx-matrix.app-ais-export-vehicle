<?xml version="1.0" encoding="UTF-8"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.leapmotor.platform</groupId>
    <artifactId>ais-parent</artifactId>
    <version>1.0.10</version>
  </parent>
  <artifactId>app-ais-export-vehicle</artifactId>
  <groupId>com.leapmotor</groupId>
  <version>${version}</version>
  <packaging>pom</packaging>
  <properties>
    <version>1.0.0</version>
    <app-account-api.version>2.2.50.RELEASE</app-account-api.version>
    <app-ais-export-nexus-client.version>1.0.0</app-ais-export-nexus-client.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <!--Project modules-->
      <!-- API -->
      <dependency>
        <groupId>com.leapmotor</groupId>
        <artifactId>app-ais-export-vehicle-client</artifactId>
        <version>${version}</version>
      </dependency>
      <dependency>
        <groupId>com.leapmotor</groupId>
        <artifactId>app-ais-export-vehicle-adapter</artifactId>
        <version>${version}</version>
      </dependency>
      <dependency>
        <groupId>com.leapmotor</groupId>
        <artifactId>app-ais-export-vehicle-app</artifactId>
        <version>${version}</version>
      </dependency>
      <dependency>
        <groupId>com.leapmotor</groupId>
        <artifactId>app-ais-export-vehicle-domain</artifactId>
        <version>${version}</version>
      </dependency>
      <dependency>
        <groupId>com.leapmotor</groupId>
        <artifactId>app-ais-export-vehicle-infrastructure</artifactId>
        <version>${version}</version>
      </dependency>
      <!--Project modules End-->
      <!-- 二方包依赖管理 -->
      <dependency>
        <groupId>com.leapmotor</groupId>
        <artifactId>app-account-api</artifactId>
        <version>${app-account-api.version}</version>
        <exclusions>
          <exclusion>
            <groupId>com.leapmotor</groupId>
            <artifactId>leapx-security</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.leapmotor</groupId>
            <artifactId>leapx-utils</artifactId>
          </exclusion>
          <exclusion>
            <artifactId>leapx-swagger</artifactId>
            <groupId>com.leapmotor</groupId>
          </exclusion>
        </exclusions>
      </dependency>

      <!-- nexus 主数据（客户）Feign client -->
      <dependency>
        <groupId>com.leapmotor</groupId>
        <artifactId>app-ais-export-nexus-client</artifactId>
        <version>${app-ais-export-nexus-client.version}</version>
      </dependency>

      <!-- leapx jDK 17版本 -->
      <dependency>
        <groupId>com.leapmotor</groupId>
        <artifactId>leapx-web</artifactId>
        <version>20250710-SNAPSHOT</version>
        <exclusions>
          <exclusion>
            <artifactId>leapx-mybatis</artifactId>
            <groupId>com.leapmotor</groupId>
          </exclusion>
          <exclusion>
            <groupId>com.leapmotor</groupId>
            <artifactId>leapx-mybatis</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.leapmotor</groupId>
            <artifactId>leapx-security</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>com.leapmotor</groupId>
        <artifactId>leapx-security</artifactId>
        <version>20250710-SNAPSHOT</version>
        <exclusions>
          <exclusion>
            <artifactId>leapx-swagger</artifactId>
            <groupId>com.leapmotor</groupId>
          </exclusion>
          <exclusion>
            <groupId>com.leapmotor</groupId>
            <artifactId>leapx-utils</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>com.leapmotor</groupId>
        <artifactId>leapx-model</artifactId>
        <version>20250710-SNAPSHOT</version>
        <exclusions>
          <exclusion>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
          </exclusion>
          <exclusion>
            <artifactId>leapx-swagger</artifactId>
            <groupId>com.leapmotor</groupId>
          </exclusion>
        </exclusions>
      </dependency>
      <!-- leapx jDK 17版本 END -->

    </dependencies>
  </dependencyManagement>
  <build>
    <finalName>app-ais-export-vehicle</finalName>
  </build>
  <modules>
    <module>app-ais-export-vehicle-client</module>
    <module>app-ais-export-vehicle-adapter</module>
    <module>app-ais-export-vehicle-app</module>
    <module>app-ais-export-vehicle-domain</module>
    <module>app-ais-export-vehicle-infrastructure</module>
    <module>app-ais-export-vehicle-generator</module>
    <module>app-ais-export-vehicle-start</module>
  </modules>
</project>
