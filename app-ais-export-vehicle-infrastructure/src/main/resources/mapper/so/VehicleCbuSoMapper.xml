    </sql>

    <!-- 列表/分页查询动态条件 -->
    <sql id="SoDetail_Where_Clause">
        <where>
            m.delete_status = 0
            <if test="qo.soNoLike != null and qo.soNoLike != ''">
                AND m.so_no LIKE CONCAT('%', #{qo.soNoLike}, '%')
            </if>
            <if test="qo.poNoLike != null and qo.poNoLike != ''">
                AND m.po_no LIKE CONCAT('%', #{qo.poNoLike}, '%')
            </if>
            <if test="qo.customerNameLike != null and qo.customerNameLike != ''">
                AND m.customer_name LIKE CONCAT('%', #{qo.customerNameLike}, '%')
            </if>
            <if test="qo.salesCompanyCode != null and qo.salesCompanyCode != ''">
                AND m.sales_company_code = #{qo.salesCompanyCode}
            </if>
            <if test="qo.orderStatus != null">
                AND m.order_status = #{qo.orderStatus}
            </if>
            <if test="qo.orderStatuses != null and qo.orderStatuses.size() > 0">
                AND m.order_status IN
                <foreach collection="qo.orderStatuses" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="qo.soNos != null and qo.soNos.size() > 0">
                AND m.so_no IN
                <foreach collection="qo.soNos" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="qo.poNos != null and qo.poNos.size() > 0">
                AND m.po_no IN
                <foreach collection="qo.poNos" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="qo.vinLike != null and qo.vinLike != ''">
                AND d.vin LIKE CONCAT('%', #{qo.vinLike}, '%')
            </if>
            <if test="qo.productionIdentifyCodeLike != null and qo.productionIdentifyCodeLike != ''">
                AND d.production_identify_code LIKE CONCAT('%', #{qo.productionIdentifyCodeLike}, '%')
            </if>
            <if test="qo.internalVehicleNoLike != null and qo.internalVehicleNoLike != ''">
                AND d.internal_vehicle_no LIKE CONCAT('%', #{qo.internalVehicleNoLike}, '%')
            </if>
            <if test="qo.vins != null and qo.vins.size() > 0">
                AND d.vin IN
                <foreach collection="qo.vins" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="qo.productionIdentifyCodes != null and qo.productionIdentifyCodes.size() > 0">
                AND d.production_identify_code IN
                <foreach collection="qo.productionIdentifyCodes" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="qo.internalVehicleNos != null and qo.internalVehicleNos.size() > 0">
                AND d.internal_vehicle_no IN
                <foreach collection="qo.internalVehicleNos" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="qo.materialCodeLike != null and qo.materialCodeLike != ''">
                AND d.material_code LIKE CONCAT('%', #{qo.materialCodeLike}, '%')
            </if>
            <if test="qo.materialCodes != null and qo.materialCodes.size() > 0">
                AND d.material_code IN
                <foreach collection="qo.materialCodes" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="qo.materialDescriptionLike != null and qo.materialDescriptionLike != ''">
                AND d.material_description LIKE CONCAT('%', #{qo.materialDescriptionLike}, '%')
            </if>
            <if test="qo.materialDescriptions != null and qo.materialDescriptions.size() > 0">
                AND d.material_description IN
                <foreach collection="qo.materialDescriptions" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="qo.syncApsResult != null">
                AND d.sync_aps_result = #{qo.syncApsResult}
            </if>
            <if test="qo.syncSapResult != null">
                AND d.sync_sap_result = #{qo.syncSapResult}
            </if>
            <if test="qo.createTimeStart != null">
                AND m.create_time &gt;= #{qo.createTimeStart}
            </if>
            <if test="qo.createTimeEnd != null">
                AND m.create_time &lt;= #{qo.createTimeEnd}
            </if>
            <if test="qo.issueTimeStart != null">
                AND m.issue_time &gt;= #{qo.issueTimeStart}
            </if>
            <if test="qo.issueTimeEnd != null">
                AND m.issue_time &lt;= #{qo.issueTimeEnd}
            </if>
            <if test="qo.qcResultTimeStart != null">
                AND m.qc_result_time &gt;= #{qo.qcResultTimeStart}
            </if>
            <if test="qo.qcResultTimeEnd != null">
                AND m.qc_result_time &lt;= #{qo.qcResultTimeEnd}
            </if>
        </where>
    </sql>

    <select id="pageSoList" resultMap="SoDetailResultMap">
        SELECT
        <include refid="SoDetail_Column_List"/>
        FROM export_vehicle_cbu_so m
        LEFT JOIN export_vehicle_cbu_so_detail d ON m.id = d.so_id AND d.delete_status = 0
        <include refid="SoDetail_Where_Clause"/>
        ORDER BY m.create_time DESC
    </select>

    <select id="listSoList" resultMap="SoDetailResultMap">
        SELECT
        <include refid="SoDetail_Column_List"/>
        FROM export_vehicle_cbu_so m
        LEFT JOIN export_vehicle_cbu_so_detail d ON m.id = d.so_id AND d.delete_status = 0
        <include refid="SoDetail_Where_Clause"/>
        ORDER BY m.create_time DESC
    </select>

    <select id="getSoDetailById" resultMap="SoDetailResultMap">
        SELECT
        <include refid="SoDetail_Column_List"/>
        FROM export_vehicle_cbu_so m
        LEFT JOIN export_vehicle_cbu_so_detail d ON m.id = d.so_id AND d.delete_status = 0
        WHERE m.id = #{id} AND m.delete_status = 0
    </select>

